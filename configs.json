      "reps": 1,
      "latency": false,
      "judge_on_panel": false,
      "tool_choice": "required"
    },
    {
      "id": "single_glm_high_search",
      "kind": "single",
      "model": "glm-5.2",
      "reasoning_effort": "high",
      "reps": 1,
      "latency": false,
      "enabled": true,
      "extra_tools": [
        {
          "type": "web_search",
          "max_uses": 3,
          "max_results": 5
        }
      ]
    },
    {
      "id": "synth_heavy2_search",
      "kind": "synthesis",
      "model": "glm-5.2",
      "judge": "glm-5.2",
      "analysis_models": [
        "glm-5.2",
        "kimi-k2.6"
      ],
      "reasoning_effort": "high",
      "reps": 1,
      "latency": false,
      "enabled": true,
      "tool_choice": "required",
      "extra_tools": [
        {
          "type": "web_search",
          "max_uses": 3,
          "max_results": 5
        }
      ]
    }
  ]
}
